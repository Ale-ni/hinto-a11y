node_modules/
dist/

# risultati delle scansioni: non vanno in repo (contengono URL, screenshot
# e a volte contenuti dei clienti)
out/
out-*/

# siti di prova: si rigenerano con `npm run fixtures`
fixtures/site/
fixtures/site-react/

